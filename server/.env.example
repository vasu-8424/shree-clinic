# ==========================================
# SHREE CLINIC PMS — SERVER CONFIGURATION
# ==========================================

# Port and Environment
PORT=5000
NODE_ENV=development
FRONTEND_URL=http://localhost:3000

# Neon PostgreSQL Database Connection
# DATABASE_URL: Pooled connection string (with ?sslmode=require&pgbouncer=true or pooled host)
DATABASE_URL="postgresql://neondb_owner:YOUR_PASSWORD@ep-YOUR-PROJECT-pooler.ap-southeast-1.aws.neon.tech/neondb?sslmode=require"
# DIRECT_URL: Direct unpooled connection string (used for migrations and schema push)
DIRECT_URL="postgresql://neondb_owner:YOUR_PASSWORD@ep-YOUR-PROJECT.ap-southeast-1.aws.neon.tech/neondb?sslmode=require"
# TEST_DATABASE_URL: Dedicated separate Neon branch database used strictly for automated tests
TEST_DATABASE_URL="postgresql://neondb_owner:YOUR_PASSWORD@ep-YOUR-TEST-BRANCH.ap-southeast-1.aws.neon.tech/neondb?sslmode=require"

# Single Admin Account (Seeded on startup)
ADMIN_EMAIL="admin@shreeclinic.com"
ADMIN_PASSWORD="ChangeThisStrongPassword123!"

# Authentication Secrets
# Generate random 64-character hex strings: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET="YOUR_SUPER_SECRET_JWT_KEY_MIN_32_CHARS_LONG"
JWT_REFRESH_SECRET="YOUR_SUPER_SECRET_REFRESH_KEY_MIN_32_CHARS_LONG"

# AES-256-GCM Data Encryption at Rest (32-byte hex string = 64 hex characters)
# node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
DATA_ENCRYPTION_KEY="0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef"

# Clinic Invoicing Settings
INVOICE_PREFIX="SHREE/26-27/"
CLINIC_NAME="SHREE Multidisciplinary Healthcare"
CLINIC_PHONE="+91 79954 78069"
CLINIC_WHATSAPP="+91 79954 78069"
CLINIC_ADDRESS="SY.NO.196/P, GROUNDFLOOR, LLP, FREEDOM HOSPITALS, SUBISHI TOWN CENTER, Shankarpalli, Mokila, Hyderabad, Telangana 501203"
CLINIC_GSTIN=""
CLINIC_RCI_NUMBER=""

# File Uploads (Cloudinary authenticated or S3 bucket)
CLOUDINARY_CLOUD_NAME=""
CLOUDINARY_API_KEY=""
CLOUDINARY_API_SECRET=""
